
<section class="apex-product-page">
  <div class="apex-product-layout">

    <div class="apex-product-image" id="ApexMainImage">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="1200"
          height="1200"
        >
        <span class="apex-image-hint">TAP TO VIEW GALLERY</span>
      {% endif %}
    </div>

    <div class="apex-product-details">
      <span class="apex-eyebrow">APEX AUTO COLLECTION</span>
      <h1>{{ product.title }}</h1>

      <p class="apex-product-price">
        {{ product.selected_or_first_available_variant.price | money }}
      </p>

      {% if product.description != blank %}
        <div class="apex-description">
          {{ product.description }}
        </div>
      {% endif %}

      {% form 'product', product %}
        {% if product.has_only_default_variant == false %}
          <label for="ApexVariant">Choose an option</label>
          <select id="ApexVariant" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} — {{ variant.price | money }}
                {% unless variant.available %} — Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}

        <label for="ApexQuantity">Quantity</label>
        <input id="ApexQuantity" type="number" name="quantity" value="1" min="1">

        <button
          type="submit"
          class="apex-add-button"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {% if product.selected_or_first_available_variant.available %}
            ADD TO BAG
          {% else %}
            SOLD OUT
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

<div class="apex-gallery" id="ApexGallery" aria-hidden="true">
  <button class="apex-gallery-close" id="ApexGalleryClose" aria-label="Close gallery">&times;</button>
  <button class="apex-gallery-arrow apex-gallery-prev" id="ApexGalleryPrev" aria-label="Previous image">&#10094;</button>

  <div class="apex-gallery-content">
    <img id="ApexGalleryImage" src="" alt="">
    <p id="ApexGalleryCount"></p>
  </div>

  <button class="apex-gallery-arrow apex-gallery-next" id="ApexGalleryNext" aria-label="Next image">&#10095;</button>
</div>

<style>
.apex-product-page,
.apex-product-page * {
  box-sizing: border-box;
}

.apex-product-page {
  width: 100%;
  padding: 55px 5%;
  background: #080B10;
  color: white;
  overflow: hidden;
}

.apex-product-layout {
  width: 100%;
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 55px;
  align-items: center;
}

.apex-product-image {
  position: relative;
  width: 100%;
  min-width: 0;
  background: #111823;
  border: 1px solid #202B39;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.apex-product-image img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 650px;
  object-fit: contain;
  object-position: center;
  padding: 15px;
}

.apex-image-hint {
  position: absolute;
  bottom: 15px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(8, 11, 16, .85);
  color: white;
  padding: 9px 14px;
  font-size: 10px;
  letter-spacing: 2px;
  border-radius: 3px;
  white-space: nowrap;
}

.apex-product-details {
  min-width: 0;
  width: 100%;
}

.apex-eyebrow {
  color: #1687FF;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.apex-product-details h1 {
  font-size: clamp(27px, 4vw, 46px);
  line-height: 1.15;
  margin: 18px 0;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.apex-product-price {
  color: #1687FF;
  font-size: 24px;
  font-weight: 800;
}

.apex-description {
  color: #AAB7C8;
  line-height: 1.8;
  margin: 25px 0;
}
.apex-description img {
  display: none !important;
}
.apex-product-details label {
  display: block;
  color: #D6DFEA;
  margin: 20px 0 8px;
  font-size: 13px;
}

.apex-product-details select,
.apex-product-details input {
  display: block;
  width: 100%;
  max-width: 100%;
  padding: 14px;
  background: #111823;
  border: 1px solid #344256;
  color: white;
  border-radius: 4px;
  font-size: 16px;
}

.apex-add-button {
  display: block;
  width: 100%;
  margin-top: 25px;
  padding: 18px;
  border: 0;
  border-radius: 4px;
  background: #1687FF;
  color: white;
  font-weight: 900;
  letter-spacing: 1px;
  cursor: pointer;
  font-size: 14px;
}

.apex-add-button:disabled {
  opacity: .5;
  cursor: not-allowed;
}

/* Full-screen product gallery */
.apex-gallery {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 999999;
  background: rgba(4, 7, 12, .97);
  align-items: center;
  justify-content: center;
  padding: 65px 55px;
}

.apex-gallery.is-open {
  display: flex;
}

.apex-gallery-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 15px;
}

.apex-gallery-content img {
  max-width: 100%;
  max-height: 85%;
  width: auto;
  height: auto;
  object-fit: contain;
  user-select: none;
}

.apex-gallery-content p {
  color: #AAB7C8;
  font-size: 13px;
}

.apex-gallery-close,
.apex-gallery-arrow {
  position: absolute;
  border: 0;
  color: white;
  background: rgba(255,255,255,.1);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.apex-gallery-close {
  top: 20px;
  right: 25px;
  width: 45px;
  height: 45px;
  font-size: 32px;
  border-radius: 50%;
}

.apex-gallery-arrow {
  top: 50%;
  transform: translateY(-50%);
  width: 45px;
  height: 55px;
  font-size: 22px;
  border-radius: 4px;
}

.apex-gallery-prev {
  left: 15px;
}

.apex-gallery-next {
  right: 15px;
}

@media (max-width: 750px) {
  .apex-product-page {
    padding: 25px 16px 45px;
  }

  .apex-product-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 25px;
  }

  .apex-product-image {
    width: 100%;
  }

  .apex-product-image img {
    width: 100%;
    height: auto;
    max-height: 55vh;
    padding: 12px;
    object-fit: contain;
  }

  .apex-product-details h1 {
    font-size: 29px;
  }

  .apex-product-price {
    font-size: 22px;
  }

  .apex-gallery {
    padding: 60px 45px;
  }

  .apex-gallery-arrow {
    width: 32px;
    height: 45px;
    font-size: 17px;
  }

  .apex-gallery-prev {
    left: 5px;
  }

  .apex-gallery-next {
    right: 5px;
  }
}
</style>

<script>
(function () {
  const mainImage = document.getElementById('ApexMainImage');
  const gallery = document.getElementById('ApexGallery');
  const galleryImage = document.getElementById('ApexGalleryImage');
  const counter = document.getElementById('ApexGalleryCount');
  const closeButton = document.getElementById('ApexGalleryClose');
  const prevButton = document.getElementById('ApexGalleryPrev');
  const nextButton = document.getElementById('ApexGalleryNext');

  if (!mainImage || !gallery || !galleryImage) return;

  const images = [
    {% for image in product.images %}
      {{ image | image_url: width: 1600 | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  if (!images.length) return;

  let currentIndex = 0;
  let touchStartX = 0;

  function showImage(index) {
    currentIndex = (index + images.length) % images.length;
    galleryImage.src = images[currentIndex];
    counter.textContent = (currentIndex + 1) + ' / ' + images.length;
    prevButton.style.display = images.length > 1 ? 'flex' : 'none';
    nextButton.style.display = images.length > 1 ? 'flex' : 'none';
  }

  function openGallery() {
    showImage(0);
    gallery.classList.add('is-open');
    gallery.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeGallery() {
    gallery.classList.remove('is-open');
    gallery.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  mainImage.addEventListener('click', openGallery);
  closeButton.addEventListener('click', closeGallery);
  prevButton.addEventListener('click', () => showImage(currentIndex - 1));
  nextButton.addEventListener('click', () => showImage(currentIndex + 1));

  gallery.addEventListener('click', function(event) {
    if (event.target === gallery) closeGallery();
  });

  document.addEventListener('keydown', function(event) {
    if (!gallery.classList.contains('is-open')) return;
    if (event.key === 'Escape') closeGallery();
    if (event.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (event.key === 'ArrowRight') showImage(currentIndex + 1);
  });

  gallery.addEventListener('touchstart', function(event) {
    touchStartX = event.changedTouches[0].screenX;
  }, { passive: true });

  gallery.addEventListener('touchend', function(event) {
    const touchEndX = event.changedTouches[0].screenX;
    const difference = touchStartX - touchEndX;

    if (Math.abs(difference) > 45) {
      showImage(currentIndex + (difference > 0 ? 1 : -1));
    }
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "APEX Product",
  "settings": [],
  "presets": [
    {
      "name": "APEX Product"
    }
  ]
}
{% endschema %}
