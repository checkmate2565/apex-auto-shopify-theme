
<section class="apex-product-page">
  <div class="apex-product-layout">
    
<div class="apex-product-image">
  {% if product.featured_image %}
    <img
      src="{{ product.featured_image | image_url: width: 1200 }}"
      alt="{{ product.featured_image.alt | default: product.title | escape }}"
      width="1200"
      height="1200"
    >
  {% endif %}
</div>


    <div class="apex-product-details">
      <span class="apex-eyebrow">APEX AUTO COLLECTION</span>
      <h1>{{ product.title }}</h1>

      <p class="apex-product-price">
        {{ product.selected_or_first_available_variant.price | money }}
      </p>

      {% if product.description != blank %}
        <div class="apex-description">
          {{ product.description }}
        </div>
      {% endif %}

      {% form 'product', product %}
        {% if product.has_only_default_variant == false %}
          <label for="ApexVariant">Choose an option</label>
          <select id="ApexVariant" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} — {{ variant.price | money }}
                {% unless variant.available %} — Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}

        <label for="ApexQuantity">Quantity</label>
        <input id="ApexQuantity" type="number" name="quantity" value="1" min="1">

        <button
          type="submit"
          class="apex-add-button"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {% if product.selected_or_first_available_variant.available %}
            ADD TO BAG
          {% else %}
            SOLD OUT
          {% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

<style>
.apex-product-page,
.apex-product-page * {
  box-sizing: border-box;
}

.apex-product-page {
  width: 100%;
  padding: 55px 5%;
  background: #080B10;
  color: white;
  overflow: hidden;
}

.apex-product-layout {
  width: 100%;
  max-width: 1200px;
  margin: auto;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 55px;
  align-items: center;
}

.apex-product-image {
  width: 100%;
  min-width: 0;
  background: #111823;
  border: 1px solid #202B39;
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.apex-product-image img {
  display: block;
  width: 100%;
  height: auto;
  max-height: 650px;
  object-fit: contain;
  object-position: center;
  padding: 15px;
}

.apex-product-details {
  min-width: 0;
  width: 100%;
}

.apex-eyebrow {
  color: #1687FF;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.apex-product-details h1 {
  font-size: clamp(27px, 4vw, 46px);
  line-height: 1.15;
  margin: 18px 0;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.apex-product-price {
  color: #1687FF;
  font-size: 24px;
  font-weight: 800;
}

.apex-description {
  color: #AAB7C8;
  line-height: 1.8;
  margin: 25px 0;
}

.apex-product-details label {
  display: block;
  color: #D6DFEA;
  margin: 20px 0 8px;
  font-size: 13px;
}

.apex-product-details select,
.apex-product-details input {
  display: block;
  width: 100%;
  max-width: 100%;
  padding: 14px;
  background: #111823;
  border: 1px solid #344256;
  color: white;
  border-radius: 4px;
  font-size: 16px;
}

.apex-add-button {
  display: block;
  width: 100%;
  margin-top: 25px;
  padding: 18px;
  border: 0;
  border-radius: 4px;
  background: #1687FF;
  color: white;
  font-weight: 900;
  letter-spacing: 1px;
  cursor: pointer;
  font-size: 14px;
}

.apex-add-button:disabled {
  opacity: .5;
  cursor: not-allowed;
}

@media (max-width: 750px) {
  .apex-product-page {
    padding: 25px 16px 45px;
  }

  .apex-product-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 25px;
  }

  .apex-product-image {
    width: 100%;
  }

  .apex-product-image img {
    width: 100%;
    height: auto;
    max-height: 55vh;
    padding: 12px;
    object-fit: contain;
  }

  .apex-product-details h1 {
    font-size: 29px;
  }

  .apex-product-price {
    font-size: 22px;
  }
}
</style>

{% schema %}
{
  "name": "APEX Product",
  "settings": [],
  "presets": [
    {
      "name": "APEX Product"
    }
  ]
}
{% endschema %}
