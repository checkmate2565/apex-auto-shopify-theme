
<section class="apex-products">
  <div class="apex-products-heading">
    <span>THE APEX COLLECTION</span>
    <h2>UPGRADE YOUR <strong>ESSENTIALS.</strong></h2>
    <p>Practical upgrades. Smarter driving. Better journeys.</p>
  </div>

  {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
    <div class="apex-product-grid">
      {% for product in section.settings.collection.products limit: 4 %}
        <a class="apex-product-card" href="{{ product.url }}">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {% endif %}
          <div class="apex-product-info">
            <h3>{{ product.title }}</h3>
            <span>{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="apex-empty-products">
      <p>Your featured products will appear here.</p>
      <span>Add products and select a collection in your Shopify theme editor.</span>
    </div>
  {% endif %}

  <a class="apex-view-all" href="{{ routes.all_products_collection_url }}">
    VIEW ALL PRODUCTS →
  </a>
</section>

<style>
  .apex-products {
    padding: 85px 6%;
    background: #080B10;
    text-align: center;
  }

  .apex-products-heading > span {
    color: #1687FF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
  }

  .apex-products-heading h2 {
    font-size: clamp(27px, 5vw, 43px);
    font-weight: 900;
    margin: 18px 0;
  }

  .apex-products-heading strong {
    color: #1687FF;
  }

  .apex-products-heading p {
    color: #9AA7B8;
    margin-bottom: 45px;
  }

  .apex-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    max-width: 1250px;
    margin: auto;
  }

  .apex-product-card {
    background: #111823;
    border: 1px solid #202B39;
    text-align: left;
    transition: transform .2s, border-color .2s;
  }

  .apex-product-card:hover {
    transform: translateY(-5px);
    border-color: #1687FF;
  }

  .apex-product-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }

  .apex-product-info {
    padding: 18px;
  }

  .apex-product-info h3 {
    font-size: 14px;
    margin: 0 0 10px;
  }

  .apex-product-info span {
    color: #1687FF;
    font-weight: 800;
  }

  .apex-empty-products {
    padding: 40px 15px;
    background: #111823;
    color: #9AA7B8;
  }

  .apex-view-all {
    display: inline-block;
    margin-top: 40px;
    padding: 16px 24px;
    background: #1687FF;
    color: white;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  @media (max-width: 750px) {
    .apex-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "APEX Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose a collection"
    }
  ],
  "presets": [
    {
      "name": "APEX Featured Products"
    }
  ]
}
{% endschema %}
