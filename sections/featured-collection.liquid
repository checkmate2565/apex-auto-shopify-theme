
<section class="apex-products">
  <div class="apex-products-heading">
    <span>THE APEX COLLECTION</span>
    <h2>UPGRADE YOUR <strong>ESSENTIALS.</strong></h2>
    <p>Practical upgrades. Smarter driving. Better journeys.</p>
  </div>

  {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
    <div class="apex-product-grid">
      {% for product in section.settings.collection.products limit: 4 %}
        <a class="apex-product-card" href="{{ product.url }}">
          <div class="apex-product-image">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="800"
                height="800"
              >
            {% else %}
              <div class="apex-no-image">APEX AUTO</div>
            {% endif %}
          </div>

          <div class="apex-product-info">
            <h3>{{ product.title }}</h3>
            <span>{{ product.price | money }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="apex-empty-products">
      <p>Your featured products will appear here.</p>
      <span>Add products and select a collection in your Shopify theme editor.</span>
    </div>
  {% endif %}

  <a class="apex-view-all" href="{{ routes.all_products_collection_url }}">
    VIEW ALL PRODUCTS <span>→</span>
  </a>
</section>

<style>
.apex-products,
.apex-products * {
  box-sizing: border-box;
}

.apex-products {
  position: relative;
  isolation: isolate;
  display: block;
  width: 100%;
  padding: 75px 6%;
  background: #080B10;
  color: #fff;
  text-align: center;
  overflow: hidden;
}

.apex-products-heading {
  display: block;
  max-width: 850px;
  margin: 0 auto 42px;
}

.apex-products-heading > span {
  color: #1687FF;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.apex-products-heading h2 {
  font-size: clamp(27px, 5vw, 43px);
  font-weight: 900;
  margin: 18px 0;
  line-height: 1.2;
}

.apex-products-heading strong {
  color: #1687FF;
}

.apex-products-heading p {
  color: #9AA7B8;
  margin: 0;
  line-height: 1.7;
}

.apex-product-grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: stretch;
  gap: 20px;
  width: 100%;
  max-width: 1250px;
  margin: 0 auto;
}

.apex-product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
  background: #111823;
  border: 1px solid #202B39;
  border-radius: 8px;
  color: #fff;
  text-decoration: none;
  text-align: left;
  transition: transform .2s, border-color .2s;
}

.apex-product-card:hover {
  transform: translateY(-4px);
  border-color: #1687FF;
}

.apex-product-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #111823;
}

.apex-product-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: 10px;
}

.apex-no-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1687FF;
  font-weight: 900;
  letter-spacing: 3px;
}

.apex-product-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  gap: 14px;
  min-height: 105px;
  padding: 17px;
}

.apex-product-info h3 {
  font-size: 14px;
  line-height: 1.5;
  font-weight: 700;
  margin: 0;
}

.apex-product-info span {
  display: block;
  color: #1687FF;
  font-weight: 800;
  font-size: 15px;
}

.apex-empty-products {
  padding: 40px 15px;
  background: #111823;
  color: #9AA7B8;
}

.apex-view-all {
  position: relative;
  display: table;
  clear: both;
  margin: 42px auto 0;
  padding: 16px 28px;
  background: #1687FF;
  border: 1px solid #1687FF;
  border-radius: 4px;
  color: #fff !important;
  text-decoration: none !important;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1px;
  line-height: 1.5;
  z-index: 2;
  transition: background .2s, transform .2s;
}

.apex-view-all:hover {
  background: #086bd3;
  transform: translateY(-2px);
}

.apex-view-all span {
  margin-left: 8px;
}

@media (max-width: 750px) {
  .apex-products {
    padding: 48px 14px;
  }

  .apex-products-heading {
    margin-bottom: 30px;
  }

  .apex-product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .apex-product-info {
    min-height: 105px;
    padding: 12px;
    gap: 10px;
  }

  .apex-product-info h3 {
    font-size: 12px;
  }

  .apex-product-info span {
    font-size: 14px;
  }

  .apex-view-all {
    margin-top: 30px;
    padding: 15px 22px;
  }
}
</style>

{% schema %}
{
  "name": "APEX Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose a collection"
    }
  ],
  "presets": [
    {
      "name": "APEX Featured Products"
    }
  ]
}
{% endschema %}
