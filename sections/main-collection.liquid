
<section class="apex-collection">
  <div class="apex-collection-heading">
    <span class="apex-eyebrow">EXPLORE APEX AUTO</span>
    <h1>{{ collection.title | escape }}</h1>

    {% if collection.description != blank %}
      <p>{{ collection.description }}</p>
    {% endif %}
  </div>

  {% paginate collection.products by 12 %}
    <div class="apex-collection-grid">
      {% for product in collection.products %}
        <a class="apex-collection-card" href="{{ product.url }}">

          <div class="apex-collection-image">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="800"
                height="800"
                loading="lazy"
              >
            {% else %}
              <div class="apex-no-image">APEX AUTO</div>
            {% endif %}
          </div>

          <div class="apex-collection-info">
            <h2>{{ product.title }}</h2>
            <span>{{ product.price | money }}</span>
          </div>

        </a>
      {% else %}
        <p>No products in this collection yet.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="apex-pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}">← Previous</a>
        {% endif %}

        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}">Next →</a>
        {% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

<style>
.apex-collection {
  background: #080B10;
  color: #fff;
  padding: 55px 5%;
  min-height: 60vh;
}

.apex-collection-heading {
  max-width: 1250px;
  margin: 0 auto 35px;
}

.apex-eyebrow {
  color: #1687FF;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 3px;
}

.apex-collection-heading h1 {
  font-size: clamp(32px, 6vw, 58px);
  margin: 12px 0;
  font-weight: 900;
}

.apex-collection-heading p {
  color: #9AA7B8;
  line-height: 1.7;
}

.apex-collection-grid {
  max-width: 1250px;
  margin: auto;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.apex-collection-card {
  display: block;
  min-width: 0;
  overflow: hidden;
  background: #111823;
  border: 1px solid #202B39;
  border-radius: 8px;
  color: white;
  text-decoration: none;
  transition: border-color .2s, transform .2s;
}

.apex-collection-card:hover {
  border-color: #1687FF;
  transform: translateY(-3px);
}

.apex-collection-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #111823;
}

.apex-collection-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  padding: 8px;
}

.apex-no-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1687FF;
  font-weight: 900;
  letter-spacing: 3px;
}

.apex-collection-info {
  padding: 16px;
  min-height: 105px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px;
}

.apex-collection-info h2 {
  font-size: 14px;
  line-height: 1.5;
  font-weight: 700;
  margin: 0;
}

.apex-collection-info span {
  color: #1687FF;
  font-weight: 800;
  font-size: 15px;
}

.apex-pagination {
  display: flex;
  justify-content: center;
  gap: 25px;
  align-items: center;
  margin-top: 45px;
  color: #9AA7B8;
}

.apex-pagination a {
  color: #1687FF;
  text-decoration: none;
}

@media (max-width: 750px) {
  .apex-collection {
    padding: 35px 14px;
  }

  .apex-collection-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .apex-collection-info {
    padding: 12px;
    min-height: 110px;
  }

  .apex-collection-info h2 {
    font-size: 12px;
  }

  .apex-collection-info span {
    font-size: 14px;
  }
}
</style>

{% schema %}
{
  "name": "APEX Collection",
  "settings": [],
  "presets": [
    {
      "name": "APEX Collection"
    }
  ]
}
{% endschema %}
